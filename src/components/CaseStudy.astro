---
import { paragraphs, type Project } from "../lib/content";
import { yearRange } from "../lib/dates";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const { name, role, outcome, description, period, technologies } = project.data;
---

<article class="case-study">
    <header>
        <h3>{name}</h3>
        <span class="period">{yearRange(period)}</span>
    </header>
    {role && <p class="role">{role}</p>}
    {outcome && <p class="outcome">{outcome}</p>}
    <div class="body">
        {paragraphs(description).map((paragraph) => (
            <p set:html={paragraph} />
        ))}
    </div>
    <ul class="tags">
        {technologies.map(({ name: tech }) => (
            <li>{tech}</li>
        ))}
    </ul>
    <ProjectLinks project={project} event="[Case study] View details" />
</article>

<style>
    .case-study {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--bg);
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
    }

    h3 {
        font-size: 22px;
    }

    .period {
        font-size: 14px;
        color: var(--muted);
        white-space: nowrap;
    }

    .role {
        margin: -8px 0 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
    }

    .outcome {
        margin: 0;
        padding: 12px 16px;
        border-radius: 8px;
        background: var(--accent-soft);
        color: var(--ink);
        font-size: 16.5px;
        line-height: 1.55;
    }

    .body {
        flex-grow: 1;
        color: var(--ink-2);
        font-size: 15.5px;
    }

    .body p:last-child {
        margin-bottom: 0;
    }

    @media (max-width: 640px) {
        .case-study {
            padding: 20px;
        }
    }
</style>
