---
import { paragraphs, type Project } from "../lib/content";
import { yearRange } from "../lib/dates";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const { name, type, role, description, period, technologies, tags } = project.data;
const keywords = [...technologies.map((tech) => tech.name), ...tags];
const typeLabel = { work: "Work", academic: "Academic", personal: "Personal" }[type];
---

<article class="archive-card" data-keywords={JSON.stringify(keywords)}>
    <header>
        <h3>{name}</h3>
        <p class="meta">
            <span class={`type type-${type}`}>{typeLabel}</span>
            <span>{yearRange(period)}</span>
        </p>
        {role && <p class="role">{role}</p>}
    </header>
    <div class="body">
        {paragraphs(description).map((paragraph) => (
            <p set:html={paragraph} />
        ))}
    </div>
    <ul class="tags">
        {technologies.map(({ name: tech }) => (
            <li>
                <button type="button" data-add-filter={tech}>
                    {tech}
                </button>
            </li>
        ))}
    </ul>
    <ProjectLinks project={project} event="[Projects] View details" />
</article>

<style>
    .archive-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--bg);
    }

    .archive-card[hidden] {
        display: none;
    }

    h3 {
        font-size: 17px;
    }

    .meta {
        display: flex;
        gap: 10px;
        align-items: center;
        margin: 4px 0 0;
        font-size: 13.5px;
        color: var(--muted);
    }

    .type {
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .type-work {
        color: var(--accent);
    }

    .type-academic {
        color: #c2410c;
    }

    .type-personal {
        color: #15803d;
    }

    @media (prefers-color-scheme: dark) {
        .type-academic {
            color: #fb923c;
        }

        .type-personal {
            color: #4ade80;
        }
    }

    .role {
        margin: 4px 0 0;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--muted);
    }

    .body {
        flex-grow: 1;
        font-size: 14.5px;
        color: var(--ink-2);
        line-height: 1.6;
    }

    .body p:last-child {
        margin-bottom: 0;
    }

    .tags button {
        all: unset;
        cursor: pointer;
    }

    .tags li:hover {
        border-color: var(--faint);
    }
</style>
