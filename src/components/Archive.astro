---
import type { Project } from "../lib/content";
import { year } from "../lib/dates";
import ArchiveRow from "./ArchiveRow.astro";
import Icon from "./Icon.astro";

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;

// Era boundaries follow the career, not the calendar: Trilogy from 2021, msg systems and KickIT before that.
const eras = [
    { label: "2021 to now", from: 2021, to: 9999 },
    { label: "2017 to 2020", from: 2017, to: 2020 },
    { label: "2010 to 2016", from: 2010, to: 2016 },
].map((era) => ({
    ...era,
    projects: projects.filter(({ data }) => {
        const start = Number(year(data.period.from));
        return start >= era.from && start <= era.to;
    }),
}));

const types = [
    { value: "all", label: "All" },
    { value: "work", label: "Work" },
    { value: "personal", label: "Side projects" },
    { value: "academic", label: "University" },
];

const keywords = [
    ...new Set(projects.flatMap(({ data }) => [...data.technologies.map((tech) => tech.name), ...data.tags])),
].sort((a, b) => a.localeCompare(b));
---

<section id="archive" class="section wrap archive" data-archive>
    <h2 class="section-title">Project archive</h2>
    <div class="intro">
        <p>
            Everything else I have built or led since 2010: {projects.length} projects across work, side projects and
            university.
        </p>
        <button class="button" type="button" data-archive-toggle aria-expanded="false" aria-controls="archive-body">
            Browse all {projects.length} projects
        </button>
    </div>
    <div id="archive-body" class="archive-body" hidden>
        <div class="toolbar">
            <div class="types" role="group" aria-label="Project type">
                {types.map(({ value, label }) => (
                    <button type="button" data-type-filter={value} aria-pressed={value === "all" ? "true" : "false"}>
                        {label}
                    </button>
                ))}
            </div>
            <label class="search">
                <Icon name="search" />
                <span class="visually-hidden">Filter by technology</span>
                <input type="search" list="archive-keywords" placeholder="Technology, e.g. AWS" data-archive-input />
            </label>
            <datalist id="archive-keywords">
                {keywords.map((keyword) => (
                    <option value={keyword} />
                ))}
            </datalist>
        </div>
        <div class="status">
            <ul class="chips" data-archive-chips></ul>
            <p class="count" data-archive-count aria-live="polite"></p>
        </div>
        {eras.map((era) => (
            <div class="era" data-era>
                <h3>{era.label}</h3>
                <ul class="rows">
                    {era.projects.map((project) => (
                        <ArchiveRow project={project} />
                    ))}
                </ul>
            </div>
        ))}
        <p class="empty" data-archive-empty hidden>
            No projects match these filters.
        </p>
    </div>
</section>

<script>
    import { track } from "../lib/analytics";

    const root = document.querySelector<HTMLElement>("[data-archive]")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-archive-toggle]")!;
    const body = root.querySelector<HTMLElement>("#archive-body")!;
    const input = root.querySelector<HTMLInputElement>("[data-archive-input]")!;
    const chips = root.querySelector<HTMLUListElement>("[data-archive-chips]")!;
    const count = root.querySelector<HTMLElement>("[data-archive-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-archive-empty]")!;
    const typeButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-type-filter]")];
    const eras = [...root.querySelectorAll<HTMLElement>("[data-era]")];
    const rows = [...root.querySelectorAll<HTMLElement>(".archive-row")];
    const label = toggle.textContent!.trim();

    const params = new URLSearchParams(location.search);
    const criteria = (params.get("filter") ?? "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean);
    let type = "all";

    // A row matches when its type fits and any of its technologies or tags equals any active filter.
    const matches = (row: HTMLElement) => {
        if (type !== "all" && row.dataset.type !== type) return false;
        if (!criteria.length) return true;
        const keywords: string[] = JSON.parse(row.dataset.keywords ?? "[]").map((k: string) => k.toLowerCase());
        return criteria.some((criterion) => keywords.includes(criterion.toLowerCase()));
    };

    function syncUrl() {
        const url = new URL(location.href);
        if (criteria.length) url.searchParams.set("filter", criteria.join(","));
        else url.searchParams.delete("filter");
        history.replaceState(null, "", url);
    }

    function renderChips() {
        chips.replaceChildren(
            ...criteria.map((criterion) => {
                const item = document.createElement("li");
                const button = document.createElement("button");
                button.type = "button";
                button.textContent = `${criterion} ×`;
                button.setAttribute("aria-label", `Remove filter ${criterion}`);
                button.addEventListener("click", () => removeCriterion(criterion));
                item.append(button);
                return item;
            }),
        );
    }

    function apply() {
        let visible = 0;
        for (const row of rows) {
            const show = matches(row);
            row.hidden = !show;
            if (show) visible += 1;
        }
        for (const era of eras) era.hidden = !era.querySelector(".archive-row:not([hidden])");
        const filtered = criteria.length > 0 || type !== "all";
        count.textContent = filtered ? `${visible} of ${rows.length} projects` : "";
        empty.hidden = visible > 0;
        renderChips();
        syncUrl();
    }

    function addCriterion(value: string) {
        const criterion = value.trim();
        if (!criterion || criteria.some((existing) => existing.toLowerCase() === criterion.toLowerCase())) return;
        criteria.push(criterion);
        track("[Projects] Search", { value: criterion });
        apply();
    }

    function removeCriterion(value: string) {
        criteria.splice(criteria.indexOf(value), 1);
        track("[Projects] Search", { value: criteria });
        apply();
    }

    function setType(value: string) {
        type = value;
        for (const button of typeButtons)
            button.setAttribute("aria-pressed", String(button.dataset.typeFilter === value));
        track("[Projects] Filter type", { type: value });
        apply();
    }

    function setOpen(open: boolean, trackIt = true) {
        body.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.textContent = open ? "Hide the archive" : label;
        if (trackIt) track("[Projects] Toggle archive", { open });
    }

    toggle.addEventListener("click", () => setOpen(body.hidden));
    for (const button of typeButtons) button.addEventListener("click", () => setType(button.dataset.typeFilter!));
    input.addEventListener("change", () => {
        addCriterion(input.value);
        input.value = "";
    });
    input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        addCriterion(input.value);
        input.value = "";
    });

    if (criteria.length) {
        setOpen(true, false);
        apply();
        root.scrollIntoView();
    }
</script>

<style>
    .intro {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .intro p {
        margin: 0;
        color: var(--muted);
    }

    .archive-body {
        margin-top: 28px;
    }

    .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .types {
        display: inline-flex;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: var(--surface);
    }

    .types button {
        font: inherit;
        font-size: 14px;
        padding: 6px 12px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
    }

    .types button[aria-pressed="true"] {
        background: var(--bg);
        color: var(--ink);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
    }

    .search {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 0 1 280px;
        padding: 7px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--muted);
    }

    .search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 14.5px;
    }

    .status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        min-height: 12px;
        margin: 12px 0 4px;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .chips :global(button) {
        font: inherit;
        font-size: 13px;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--accent);
        background: var(--accent-soft);
        color: var(--ink);
        cursor: pointer;
    }

    .count {
        margin: 0;
        font-size: 14px;
        color: var(--muted);
    }

    .era {
        margin-top: 28px;
    }

    .era[hidden] {
        display: none;
    }

    .era h3 {
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
        margin: 0 0 6px 8px;
    }

    .rows {
        margin: 0;
        padding: 0;
        list-style: none;
        border-bottom: 1px solid var(--border);
    }

    .empty {
        text-align: center;
        color: var(--muted);
        padding: 24px 0;
    }

    @media (max-width: 640px) {
        .search {
            flex: 1 1 100%;
        }
    }
</style>
