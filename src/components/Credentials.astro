---
import type { CollectionEntry } from "astro:content";

import { monthRange, year, yearRange } from "../lib/dates";

interface Props {
    certifications: CollectionEntry<"certification">[];
    education: CollectionEntry<"education">[];
}

const { certifications, education } = Astro.props;
const degrees = education.filter(({ data }) => data.featured);
const earlier = education.filter(({ data }) => !data.featured);
---

<section id="credentials" class="section wrap">
    <h2 class="section-title">Credentials</h2>
    <div class="columns">
        <div>
            <h3 class="column-title">Certifications</h3>
            <ul class="items">
                {certifications.map(({ data }) => (
                    <li>
                        {data.link ? (
                            <a href={data.link} target="_blank" rel="noopener">
                                {data.short}
                            </a>
                        ) : (
                            <span class="name">{data.short}</span>
                        )}
                        <span class="when">{year(data.period.at)}</span>
                    </li>
                ))}
            </ul>
        </div>
        <div>
            <h3 class="column-title">Education</h3>
            <ul class="items">
                {degrees.map(({ data }) => (
                    <li>
                        <span class="name">{data.degree}</span>
                        <span class="where">{data.title}</span>
                        <span class="when">{yearRange(data.period)}</span>
                    </li>
                ))}
            </ul>
            {earlier.length > 0 && (
                <details>
                    <summary>Earlier education</summary>
                    <ul class="items">
                        {earlier.map(({ data }) => (
                            <li>
                                <span class="name">{data.title}</span>
                                <span class="where">{data.body}</span>
                                <span class="when">{monthRange(data.period)}</span>
                            </li>
                        ))}
                    </ul>
                </details>
            )}
        </div>
    </div>
</section>

<style>
    .columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 56px;
    }

    .column-title {
        font-size: 18px;
        margin-bottom: 14px;
    }

    .items {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .items li {
        display: flex;
        flex-direction: column;
        margin-bottom: 14px;
    }

    .items a,
    .name {
        font-weight: 600;
    }

    .name {
        color: var(--ink);
    }

    .where {
        color: var(--ink-2);
        font-size: 15px;
    }

    .when {
        font-size: 14px;
        color: var(--muted);
    }

    summary {
        cursor: pointer;
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 12px;
    }

    @media (max-width: 760px) {
        .columns {
            grid-template-columns: minmax(0, 1fr);
            gap: 32px;
        }
    }
</style>
