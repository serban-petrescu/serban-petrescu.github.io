---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import HeroActions from "./HeroActions.astro";

interface Props {
    name: string;
    role: string;
    tagline: string;
    avatar: ImageMetadata;
    linkedin: string;
    cv: string;
    writing: string;
}

const { name, role, tagline, avatar, ...actions } = Astro.props;
---

<section class="hero">
    <div class="inner wrap">
        <Image class="avatar" src={avatar} alt={name} width={144} height={144} densities={[1, 2]} loading="eager" />
        <h1>{name}</h1>
        <p class="role">{role}</p>
        <p class="tagline">{tagline}</p>
        <HeroActions {...actions} />
    </div>
    <a class="scroll" href="#about">
        Scroll to find out more ↓
    </a>
</section>

<style>
    .hero {
        position: relative;
        min-height: calc(100vh - 57px);
        display: grid;
        place-items: center;
        text-align: center;
        border-bottom: 1px solid var(--border);
        background: radial-gradient(ellipse at top, var(--accent-soft), transparent 60%);
    }

    .inner {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero :global(.avatar) {
        width: 144px;
        height: 144px;
        border-radius: 50%;
        border: 1px solid var(--border);
        margin-bottom: 24px;
    }

    h1 {
        font-size: 48px;
        letter-spacing: -0.03em;
    }

    .role {
        margin: 8px 0 0;
        font-size: 20px;
        font-weight: 500;
        color: var(--ink-2);
    }

    .tagline {
        margin: 12px 0 28px;
        font-size: 21px;
        color: var(--muted);
    }

    .scroll {
        position: absolute;
        bottom: 24px;
        font-size: 14px;
        color: var(--muted);
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 34px;
        }

        .tagline {
            font-size: 18px;
        }
    }
</style>
