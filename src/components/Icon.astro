    arrow: ["M5 12h14", "M13 6l6 6-6 6"],
    close: ["M18 6 6 18", "M6 6l12 12"],
    left: ["M15 18l-6-6 6-6"],
    right: ["M9 18l6-6-6-6"],
    search: ["M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z", "M21 21l-4.3-4.3"],
    print: [
        "M6 9V2h12v7",
        "M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2",
        "M6 14h12v8H6z",
    ],
} as const;

export type IconName = keyof typeof brands | keyof typeof strokes;

interface Props {
    name: IconName;
    class?: string;
    label?: string;
}

const { name, class: className = "icon", label } = Astro.props;
const brand = name in brands ? brands[name as keyof typeof brands] : undefined;
const stroke = name in strokes ? strokes[name as keyof typeof strokes] : undefined;
---

<svg
    class={className}
    viewBox="0 0 24 24"
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
    fill={brand ? "currentColor" : "none"}
    stroke={stroke ? "currentColor" : undefined}
    stroke-width={stroke ? 2 : undefined}
    stroke-linecap="round"
    stroke-linejoin="round"
>
    {brand && <path d={brand} />}
    {stroke?.map((d) => (
        <path d={d} />
    ))}
</svg>
