---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import HeroActions from "./HeroActions.astro";

interface Props {
    name: string;
    role: string;
    tagline: string;
    avatar: ImageMetadata;
    linkedin: string;
    cv: string;
    writing: string;
}

const { name, role, tagline, avatar, ...actions } = Astro.props;
---

<section class="hero wrap">
    <Image class="avatar" src={avatar} alt={name} width={112} height={112} loading="eager" />
    <div>
        <h1>{name}</h1>
        <p class="role">{role}</p>
        <p class="tagline">{tagline}</p>
        <HeroActions {...actions} />
    </div>
</section>

<style>
    .hero {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 32px;
        align-items: center;
        padding-top: 64px;
        padding-bottom: 8px;
    }

    .hero :global(.avatar) {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        border: 1px solid var(--border);
    }

    h1 {
        font-size: 40px;
        letter-spacing: -0.025em;
    }

    .role {
        margin: 6px 0 0;
        font-size: 18px;
        font-weight: 500;
        color: var(--ink-2);
    }

    .tagline {
        margin: 10px 0 22px;
        font-size: 20px;
        color: var(--muted);
    }

    @media (max-width: 640px) {
        .hero {
            grid-template-columns: minmax(0, 1fr);
            gap: 20px;
            padding-top: 40px;
        }

        .hero :global(.avatar) {
            width: 88px;
            height: 88px;
        }

        h1 {
            font-size: 32px;
        }

        .tagline {
            font-size: 18px;
        }
    }
</style>
